    "primaryCtaLabel": {
      "type": "string",
      "default": "Design my Ajax system"
    },
    "primaryCtaUrl": {
      "type": "string",
      "default": "/ajax-calculator/"
    },
    "secondaryCtaLabel": {
      "type": "string",
      "default": "Call 1300 225 276"
