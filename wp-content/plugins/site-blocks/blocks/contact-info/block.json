{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "site/contact-info",
  "version": "1.0.0",
  "title": "Contact Info",
  "category": "theme",
  "icon": "location",
  "description": "Business contact details with address, hours and map.",
  "keywords": ["contact", "address", "info"],
  "textdomain": "site-blocks",
  "supports": {
    "html": false,
    "align": false,
    "multiple": false
  },
  "attributes": {
    "organizationName": {
      "type": "string",
      "default": "Safeguard Security Services"
    },
    "streetAddress": {
      "type": "string",
      "default": "2/2 Stennett Road"
    },
    "city": {
      "type": "string",
      "default": "Ingleburn"
    },
    "region": {
      "type": "string",
      "default": "NSW"
    },
    "postalCode": {
      "type": "string",
      "default": "2565"
    },
    "country": {
      "type": "string",
      "default": "Australia"
    },
    "phone": {
      "type": "string",
      "default": "1300 225 276"
    },
    "email": {
      "type": "string",
      "default": "sales@safeguardsecurity.com.au"
    },
    "hoursNote": {
      "type": "string",
      "default": "Mon–Fri 8 AM – 6 PM · Sat–Sun closed"
    },
    "responseNote": {
      "type": "string",
      "default": "We aim to reply within one business day."
    },
    "showMap": {
      "type": "boolean",
      "default": true
    }
  },
  "render": "file:./render.php"
}
