{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "site/package-grid",
  "version": "1.0.0",
  "title": "Package Grid",
  "category": "theme",
  "icon": "grid-view",
  "description": "Display security packages from the Security Packages post type.",
  "keywords": ["packages", "security", "grid", "services"],
  "textdomain": "site-blocks",
  "supports": {
    "html": false,
    "align": false,
    "multiple": true
  },
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Security packages"
    },
    "intro": {
      "type": "string",
      "default": "Starter installation packages for cameras, alarms, and intercom systems."
    },
    "packageType": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "number",
      "default": 0
    }
  },
  "render": "file:./render.php"
}
