{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "site/contact-hero",
  "version": "1.0.0",
  "title": "Contact Hero",
  "category": "theme",
  "icon": "email-alt",
  "description": "Contact page headline.",
  "keywords": ["contact", "hero", "headline"],
  "textdomain": "site-blocks",
  "supports": {
    "html": false,
    "align": false,
    "multiple": false
  },
  "attributes": {
    "headline": {
      "type": "string",
      "default": "Contact us"
    },
    "subhead": {
      "type": "string",
      "default": "Questions about quotes, installs or support? Call, email or send a message and our team will get back to you."
    }
  },
  "render": "file:./render.php"
}
