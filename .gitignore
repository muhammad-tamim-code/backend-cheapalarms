# Backend repo: track cheapalarms-plugin + site-blocks (Safeguard marketing) — nothing else.
# WordPress core and all other wp-content are intentionally untracked.

# 1) Ignore everything at the repo root...
/*

# 2) ...then walk back down ONLY to the plugin folder.
!/.gitignore
!/wp-content
/wp-content/*
!/wp-content/plugins
/wp-content/plugins/*
!/wp-content/plugins/cheapalarms-plugin
!/wp-content/plugins/site-blocks

# 3) Never commit real secrets / per-instance config (defense in depth;
#    the plugin's own .gitignore also covers these).
wp-content/plugins/cheapalarms-plugin/config/secrets.php
wp-content/plugins/cheapalarms-plugin/config/instance.php
**/secrets.php

# 4) Build artifacts / vendor (also covered by the plugin .gitignore).
wp-content/plugins/cheapalarms-plugin/vendor/
wp-content/plugins/cheapalarms-plugin/*.zip
wp-content/plugins/cheapalarms-plugin/deploy/*.zip
wp-content/plugins/site-blocks/deploy/*.zip
wp-content/plugins/*.zip
